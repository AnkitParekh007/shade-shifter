# Machine-specific sidecars (absolute local paths / interpreter) — not portable.
.graphify_python
.graphify_root
.graphify_detect.json
.graphify_extract.json
.graphify_ast.json
.graphify_semantic*.json
.graphify_analysis.json
.graphify_cached.json
.graphify_uncached.txt
.graphify_chunk_*.json
.needs_update

# Extraction cache (regenerated by `graphify update .`).
cache/

# Dated backups of the previous graph, written on every update. Pure churn —
# git history already gives us the old versions.
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Local signature sidecar for the label file.
.graphify_labels.json.sig

# Committed, shareable artifacts: graph.json, graph.html, GRAPH_REPORT.md,
# manifest.json, cost.json, .graphify_labels.json
